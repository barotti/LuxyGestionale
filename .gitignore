# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# scripts locali (contengono logica di setup, non necessari in prod)
/scripts

# typescript
*.tsbuildinfo
next-env.d.ts

# /app/generated/prisma  ← incluso nel repo, generato da postinstall su Vercel
# escludi binary Windows-specifici (vengono rigenerati da prisma generate)
app/generated/prisma/*.dll.node
app/generated/prisma/*.dll.node.tmp*
app/generated/prisma/*.tmp*

# upload utenti (persistono sul server, non in git)
public/uploads/
